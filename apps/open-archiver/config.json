{
  "name": "Open Archiver",
  "id": "open-archiver",
  "tipi_version": 1,
  "version": "latest",
  "min_tipi_version": "4.5.0",
  "available": true,
  "exposable": true,
  "dynamic_config": true,
  "port": 8473,
  "categories": ["utilities"],
  "short_desc": "Modern, open-source email archiving solution.",
  "author": "LogicLabs",
  "source": "https://github.com/LogicLabs-OU/OpenArchiver",
  "website": "https://openarchiver.org",
  "description": "Open Archiver is a modern, open-source email archiving solution designed to keep your email history safe, searchable, and accessible. It supports archiving from Google Workspace, Microsoft 365, and Generic IMAP servers.",
  "supported_architectures": ["arm64", "amd64"],
  "uid": 1000,
  "gid": 1000,
  "form_fields": [
    {
      "type": "random",
      "label": "Postgres Password",
      "env_variable": "POSTGRES_PASSWORD",
      "min": 24,
      "required": true
    },
    {
      "type": "random",
      "label": "Redis Password",
      "env_variable": "REDIS_PASSWORD",
      "min": 24,
      "required": true
    },
    {
      "type": "random",
      "label": "Meilisearch Master Key",
      "env_variable": "MEILI_MASTER_KEY",
      "min": 32,
      "required": true
    },
    {
      "type": "random",
      "label": "JWT Secret",
      "env_variable": "JWT_SECRET",
      "min": 64,
      "required": true
    },
    {
      "type": "random",
      "label": "DB Encryption Key (Hex)",
      "env_variable": "ENCRYPTION_KEY",
      "encoding": "hex",
      "min": 64,
      "required": true
    },
    {
      "type": "random",
      "label": "Storage Encryption Key (Hex)",
      "env_variable": "STORAGE_ENCRYPTION_KEY",
      "encoding": "hex",
      "min": 64,
      "required": true
    }
  ]
}