{
  "schemaVersion": 2,
  "services": [
    {
      "name": "open-archiver",
      "image": "logiclabshq/open-archiver:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        { "key": "NODE_ENV", "value": "development" },
        { "key": "HOST", "value": "0.0.0.0" },
        { "key": "PORT_FRONTEND", "value": "3000" },
        { "key": "PORT_BACKEND", "value": "4000" },
        { "key": "APP_URL", "value": "${APP_PROTOCOL}://${APP_DOMAIN}" },
        { "key": "ORIGIN", "value": "${APP_PROTOCOL}://${APP_DOMAIN}" },
        { "key": "POSTGRES_DB", "value": "open_archive" },
        { "key": "POSTGRES_USER", "value": "open_archiver_user" },
        { "key": "POSTGRES_PASSWORD", "value": "${POSTGRES_PASSWORD}" },
        { "key": "DATABASE_URL", "value": "postgresql://open_archiver_user:${POSTGRES_PASSWORD}@postgres:5432/open_archive" },
        { "key": "REDIS_HOST", "value": "valkey" },
        { "key": "REDIS_PORT", "value": "6379" },
        { "key": "REDIS_PASSWORD", "value": "${REDIS_PASSWORD}" },
        { "key": "REDIS_TLS_ENABLED", "value": "false" },
        { "key": "MEILI_HOST", "value": "http://meilisearch:7700" },
        { "key": "MEILI_MASTER_KEY", "value": "${MEILI_MASTER_KEY}" },
        { "key": "TIKA_URL", "value": "http://tika:9998" },
        { "key": "STORAGE_TYPE", "value": "local" },
        { "key": "STORAGE_LOCAL_ROOT_PATH", "value": "/var/data/open-archiver" },
        { "key": "JWT_SECRET", "value": "${JWT_SECRET}" },
        { "key": "ENCRYPTION_KEY", "value": "${ENCRYPTION_KEY}" },
        { "key": "STORAGE_ENCRYPTION_KEY", "value": "${STORAGE_ENCRYPTION_KEY}" },
        { "key": "ENABLE_DELETION", "value": "true" }
      ],
      "dependsOn": {
        "postgres": {
          "condition": "service_healthy"
        },
        "valkey": {
          "condition": "service_started"
        },
        "meilisearch": {
          "condition": "service_started"
        },
        "tika": {
          "condition": "service_started"
        }
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/files",
          "containerPath": "/var/data/open-archiver"
        }
      ]
    },
    {
      "name": "postgres",
      "image": "postgres:17",
      "isMain": false,
      "environment": [
        { "key": "POSTGRES_DB", "value": "open_archive" },
        { "key": "POSTGRES_USER", "value": "open_archiver_user" },
        { "key": "POSTGRES_PASSWORD", "value": "${POSTGRES_PASSWORD}" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U open_archiver_user -d open_archive",
        "interval": "5s",
        "timeout": "5s",
        "retries": 10
      }
    },
    {
      "name": "valkey",
      "image": "valkey/valkey:8-alpine",
      "isMain": false,
      "command": ["valkey-server", "--requirepass", "${REDIS_PASSWORD}"],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/valkey",
          "containerPath": "/data"
        }
      ]
    },
    {
      "name": "meilisearch",
      "image": "getmeili/meilisearch:v1.15",
      "isMain": false,
      "environment": [
        { "key": "MEILI_MASTER_KEY", "value": "${MEILI_MASTER_KEY}" },
        { "key": "MEILI_ENV", "value": "production" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/meilisearch",
          "containerPath": "/meili_data"
        }
      ]
    },
    {
      "name": "tika",
      "image": "apache/tika:3.2.2.0-full",
      "isMain": false
    }
  ]
}