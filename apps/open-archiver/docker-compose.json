{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "open-archiver",
      "image": "logiclabshq/open-archiver:latest",
      "isMain": true,
      "internalPort": 3000,
      "environment": {
        "NODE_ENV": "production",
        "PORT_FRONTEND": "3000",
        "PORT_BACKEND": "4000",
        "APP_URL": "${APP_PROTOCOL}://${APP_DOMAIN}",
        "ORIGIN": "${APP_PROTOCOL}://${APP_DOMAIN}",
        "POSTGRES_DB": "open_archive",
        "POSTGRES_USER": "open_archiver_user",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "DATABASE_URL": "postgresql://open_archiver_user:${POSTGRES_PASSWORD}@postgres:5432/open_archive",
        "REDIS_HOST": "valkey",
        "REDIS_PORT": "6379",
        "REDIS_PASSWORD": "${REDIS_PASSWORD}",
        "MEILI_HOST": "http://meilisearch:7700",
        "MEILI_MASTER_KEY": "${MEILI_MASTER_KEY}",
        "TIKA_URL": "http://tika:9998",
        "STORAGE_TYPE": "local",
        "STORAGE_LOCAL_ROOT_PATH": "/var/data/open-archiver",
        "JWT_SECRET": "${JWT_SECRET}",
        "ENCRYPTION_KEY": "${ENCRYPTION_KEY}",
        "STORAGE_ENCRYPTION_KEY": "${STORAGE_ENCRYPTION_KEY}",
        "ENABLE_DELETION": "true"
      },
      "dependsOn": [
        "postgres",
        "valkey",
        "meilisearch",
        "tika"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/files",
          "containerPath": "/var/data/open-archiver"
        }
      ]
    },
    {
      "name": "postgres",
      "image": "postgres:17-alpine",
      "isMain": false,
      "environment": {
        "POSTGRES_DB": "open_archive",
        "POSTGRES_USER": "open_archiver_user",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgres",
          "containerPath": "/var/lib/postgresql/data"
        }
      ]
    },
    {
      "name": "valkey",
      "image": "valkey/valkey:8-alpine",
      "isMain": false,
      "command": [
        "valkey-server",
        "--requirepass",
        "${REDIS_PASSWORD}"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/valkey",
          "containerPath": "/data"
        }
      ]
    },
    {
      "name": "meilisearch",
      "image": "getmeili/meilisearch:v1.15",
      "isMain": false,
      "environment": {
        "MEILI_MASTER_KEY": "${MEILI_MASTER_KEY}",
        "MEILI_ENV": "production"
      },
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/meilisearch",
          "containerPath": "/meili_data"
        }
      ]
    },
    {
      "name": "tika",
      "image": "apache/tika:3.2.2.0-full",
      "isMain": false
    }
  ]
}